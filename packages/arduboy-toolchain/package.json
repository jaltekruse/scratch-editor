{
  "name": "@scratch/arduboy-toolchain",
  "version": "15.3.0",
  "description": "Compile Arduboy sketches to firmware and upload them to Arduboy-compatible hardware, entirely in the browser.",
  "keywords": [
    "arduboy",
    "arduino",
    "avr",
    "atmega32u4",
    "wasm",
    "webserial"
  ],
  "license": "AGPL-3.0-only",
  "author": "Scratch Foundation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/arduboy-toolchain.js",
      "default": "./dist/arduboy-toolchain.js"
    },
    "./toolchain/*": "./dist/toolchain/*"
  },
  "module": "dist/arduboy-toolchain.js",
  "files": [
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "TRADEMARK",
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && vite build && vite build --config vite.worker.config.js && tsx scripts/prepare-assets.ts",
    "clean": "rimraf dist",
    "dev": "vite",
    "format": "prettier --write . && eslint --fix",
    "lint": "eslint && prettier --check .",
    "prepare-assets": "tsx scripts/prepare-assets.ts",
    "prepublishOnly": "echo \"Please publish through CI only.\" && exit 1",
    "test": "npm run lint && vitest run"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "devDependencies": {
    "@horang-corp/avr-gcc-wasm": "0.2.0",
    "@types/node": "24.19.2",
    "@types/w3c-web-serial": "1.0.9",
    "avr8js": "0.21.1",
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.97",
    "prettier": "3.9.10",
    "rimraf": "6.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "unplugin-dts": "1.1.2",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.12"
  }
}
